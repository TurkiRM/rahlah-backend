# Copy to .env for local use, or set these directly in Render's dashboard.
# None are required to run locally — the app auto-generates a supervisor
# account and VAPID keys into data/*.json if these aren't set. VAPID keys ARE
# required on a host with an ephemeral filesystem (like Render's free tier),
# so they don't reset on every restart. See DEPLOY.md.

# Postgres connection string. Without this, accounts/cars/trips live in a
# local JSON file that does NOT survive a restart on Render's free tier.
# Free, non-expiring options: neon.tech or supabase.com.
DATABASE_URL=

SUPERVISOR_USERNAME=
SUPERVISOR_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Comma-separated list of frontend URLs allowed to call this API.
# Leave unset during testing — CORS defaults to allowing any origin.
ALLOWED_ORIGINS=

# Render sets this automatically — no need to set it yourself.
# PORT=3000
